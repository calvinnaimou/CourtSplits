# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node / frontend
frontend/node_modules/
frontend/dist/

# Env files (may hold environment-specific/deploy secrets)
.env
.env.local
.env.*.local

# Data - the raw Excel is paid BigDataBall content and doesn't belong in
# git. The processed parquet files under data/processed/ ARE committed on
# purpose (see CLAUDE.md) -- the 2025-26 season is finished/historical and
# Render has no other way to get that data without them being in the repo.
# Live 2026-27 season data goes through Postgres instead (engine/live_db.py),
# not another parquet file, so this won't need revisiting each season.
data/raw/*

# Transient download destination for the daily live-data ingestion script
# (scripts/ingest_live_data.py) -- never meant to be committed.
data/live/

# OS
.DS_Store

# Claude Code local settings - machine-specific tool permissions, not
# project config, shouldn't be shared across machines/collaborators.
.claude/
